{
    "name": "comando",
    "version": "0.1.0",
    "private": true,
    "description": "Workspace local-first para programar con IA.",
    "author": "José Gurruchaga",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jsgrrchg/Comando.git"
    },
    "bugs": {
        "url": "https://github.com/jsgrrchg/Comando/issues"
    },
    "homepage": "https://github.com/jsgrrchg/Comando#readme",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "main": "out/main/index.js",
    "scripts": {
        "predev": "pnpm run stage:ai",
        "dev": "node scripts/dev.mjs",
        "prebuild": "pnpm run stage:ai",
        "build": "electron-vite build",
        "build:windows-acp": "node scripts/build-windows-acp-bundles.mjs",
        "build:windows-acp:arm64": "node scripts/build-windows-acp-bundles.mjs --arm64",
        "build:windows-acp:x64": "node scripts/build-windows-acp-bundles.mjs --x64",
        "icons:build": "node scripts/build-icons.mjs",
        "prepackage:mac": "pnpm run icons:build",
        "package:mac": "node scripts/package-macos-app.mjs",
        "release:mac": "node scripts/package-macos-app.mjs --publish always",
        "prepackage:win": "pnpm run icons:build",
        "package:win": "node scripts/package-windows-app.mjs",
        "prepackage:win:arm64": "pnpm run icons:build",
        "package:win:arm64": "node scripts/package-windows-app.mjs --arm64",
        "release:win:arm64": "node scripts/package-windows-app.mjs --arm64 --publish always",
        "prepackage:win:x64": "pnpm run icons:build",
        "package:win:x64": "node scripts/package-windows-app.mjs --x64",
        "release:win:x64": "node scripts/package-windows-app.mjs --x64 --publish always",
        "prepackage:linux": "pnpm run icons:build",
        "package:linux": "node scripts/package-linux-app.mjs --publish never",
        "package:linux:appimage": "node scripts/package-linux-app.mjs AppImage --publish never",
        "package:linux:deb": "node scripts/package-linux-app.mjs deb --publish never",
        "package:linux:rpm": "node scripts/package-linux-app.mjs rpm --publish never",
        "release:linux": "node scripts/package-linux-app.mjs --publish always",
        "lint": "eslint .",
        "postinstall": "pnpm run rebuild:native",
        "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
        "stage:ai": "node scripts/ai/stage-ai-runtimes.mjs",
        "stage:codex-runtime": "node scripts/ai/stage-codex-runtime.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "verify:ai-runtimes": "node scripts/ai/verify-ai-runtimes.mjs",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^0.19.0",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.3",
        "@codemirror/legacy-modes": "^6.5.2",
        "@iconify-json/catppuccin": "^1.2.17",
        "@lezer/highlight": "^1.2.3",
        "@monaco-editor/react": "^4.7.0",
        "@shikijs/langs": "^4.0.2",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "better-sqlite3": "^12.9.0",
        "electron-updater": "^6.8.3",
        "monaco-editor": "^0.55.1",
        "ms": "^2.1.3",
        "node-pty": "^1.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "simple-git": "^3.36.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2",
        "zod": "^4.3.6",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.2.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^41.2.1",
        "electron-builder": "26.8.1",
        "electron-vite": "^5.0.0",
        "eslint": "^10.2.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.5.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.58.2",
        "vite": "^7.3.2",
        "vitest": "^4.1.4"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "electron",
            "esbuild",
            "node-pty"
        ]
    },
    "build": {
        "appId": "io.github.jsgrrchg.comando",
        "productName": "Comando",
        "electronUpdaterCompatibility": ">=2.16",
        "directories": {
            "buildResources": "resources",
            "output": "dist"
        },
        "files": [
            "CHANGELOG.md",
            "out/**/*",
            "package.json",
            "node_modules/**/*",
            "!node_modules/better-sqlite3/build/Release/test_extension.node",
            "!node_modules/node-pty/bin/**/*"
        ],
        "asar": true,
        "npmRebuild": false,
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*",
            "node_modules/node-pty/**/*"
        ],
        "extraResources": [
            {
                "from": "resources/icons/windows.ico",
                "to": "icons/windows.ico"
            },
            {
                "from": "resources/icons/app.png",
                "to": "icons/app.png"
            },
            {
                "from": "build/package-resources/ai",
                "to": "ai",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "icon": "resources/icons/macos.icon",
            "x64ArchFiles": "{Contents/Resources/ai/**/*,Contents/Resources/app.asar.unpacked/node_modules/**/*}",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "minimumSystemVersion": "15.0",
            "artifactName": "${productName}-${version}-${arch}.${ext}"
        },
        "dmg": {
            "icon": "resources/icons/macos.icns"
        },
        "win": {
            "icon": "resources/icons/windows.ico",
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "artifactName": "${productName}-${version}-win-${arch}.${ext}"
        },
        "linux": {
            "category": "Development",
            "desktop": {
                "entry": {
                    "StartupWMClass": "comando"
                }
            },
            "icon": "resources/icons/app.png",
            "maintainer": "José Gurruchaga <jsgrrchg@users.noreply.github.com>",
            "target": [
                "AppImage",
                "deb",
                "rpm"
            ],
            "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
        }
    }
}
