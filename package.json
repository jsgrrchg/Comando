{
    "name": "comando",
    "version": "0.1.0",
    "private": true,
    "description": "Workspace local-first para programar con IA.",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "main": "out/main/index.js",
    "scripts": {
        "predev": "pnpm run stage:ai",
        "dev": "electron-vite dev",
        "prebuild": "pnpm run stage:ai",
        "build": "electron-vite build",
        "lint": "eslint .",
        "postinstall": "pnpm run rebuild:native",
        "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
        "stage:ai": "node scripts/ai/stage-ai-runtimes.mjs",
        "stage:codex-runtime": "node scripts/ai/stage-codex-runtime.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "verify:ai-runtimes": "node scripts/ai/verify-ai-runtimes.mjs",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^0.18.2",
        "@monaco-editor/react": "^4.7.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "better-sqlite3": "^12.9.0",
        "monaco-editor": "^0.55.1",
        "node-pty": "^1.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "simple-git": "^3.36.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@eslint/js": "^9.0.0",
        "@tailwindcss/vite": "^4.2.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^41.2.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.0.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^17.5.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vite": "^7.3.2",
        "vitest": "^4.1.4"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "electron",
            "esbuild",
            "node-pty"
        ]
    }
}
